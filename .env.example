# Supabase Configuration
# Erforderlich für die App-Funktionalität
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Portal Password
# Passwort für den Zugriff auf das Admin-Portal (/admin)
ADMIN_PASSWORD=your-secure-admin-password

# News Portal Password
# Passwort für den Zugriff auf das News-Portal (/news-portal)
NEWS_PORTAL_PASSWORD=your-secure-news-portal-password

# Optional: Node Environment
# Wird automatisch von Next.js gesetzt, kann aber manuell überschrieben werden
# NODE_ENV=production
